# Where the PayPulse backend is. For an Android phone on the same wifi as your
# computer use the computer's LAN address, e.g. http://192.168.1.42:8000
VITE_API_BASE_URL=http://localhost:8000

# Set to false ONLY for browser testing against a backend that has
# REQUIRE_REGISTERED_DEVICES=false. Leave unset for the real app.
# VITE_REQUIRE_ENROLLMENT=false
